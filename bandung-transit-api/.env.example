# PostgreSQL + PostGIS connection string
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bandung_transit
# Supabase (use IPv4 Session Pooler URI on port 5432 for Render free tier):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional comma-separated production frontend URLs for CORS (e.g. custom domain)
# Note: *.vercel.app, *.pages.dev, and localhost/LAN origins are already allowed by default.
ALLOWED_ORIGINS=

# Automatically seed MJT BRT + Commuter Line data on first boot if database is empty
AUTO_SEED_ON_EMPTY=true
